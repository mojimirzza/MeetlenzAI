APP_NAME=MeetLens
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/meetlens.db
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_API_KEY=local
LLM_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_CANDIDATES_PER_CLUSTER=2
QUESTION_SIMILARITY_THRESHOLD=0.82
PRIVACY_MODE=strict
ASR_MODEL=small

# Set true only if you have installed the optional packages.
ENABLE_ASR=false
ENABLE_DIARIZATION=false
HF_TOKEN=
